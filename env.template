# Calgary Grocery Hub - Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== AI BACKEND =====
# Default order is the Anthropic API first, then the local Claude Code CLI,
# then statistical-only. The API leads because an API key does not expire:
# an expired CLI login silently killed the 2026-10-21 run.
#
# Check both at any time:   python ai_backends.py
# Full preflight:           python verify_installation.py
#
# AI_BACKEND: auto | anthropic | claude_code | gemini | statistical
AI_BACKEND=auto

# Anthropic API. Needs a credit balance at console.anthropic.com.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Bulk classification runs on Sonnet; the three write-ups run on Opus.
# Haiku is ~20x cheaper than Sonnet for the classification pass if you
# want to trim cost: ANTHROPIC_SCORING_MODEL=claude-haiku-5-5
ANTHROPIC_SCORING_MODEL=claude-sonnet-5-5
ANTHROPIC_REPORT_MODEL=claude-opus-5-5

# Claude Code CLI (standby). Log in once as the Windows user that runs the
# scheduled task:  claude login
CLAUDE_CODE_SCORING_MODEL=sonnet
CLAUDE_CODE_REPORT_MODEL=opus

# Parallel calls for scoring, and items per call
AI_WORKERS=3
AI_BATCH_SIZE=40
# Reuse earlier classifications for identical item names (1 = on)
AI_NAME_CACHE=1
# If no backend answers: 1 = stop the run and alert (default), 0 = allow
# a statistical-only run
AI_REQUIRE_BACKEND=1

# ===== OPTIONAL: GEMINI (off by default - its project hit a spend cap) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=gemini-2.5-flash
AI_ALLOW_PAID_FALLBACK=0

# ===== SCRAPER SETTINGS =====

# Your postal code for flyer searches (default: T3M1M9 - Seton, Calgary)
POSTAL_CODE=T3M1M9

# ===== DASHBOARD SETTINGS =====

# FastAPI production dashboard port
API_PORT=8000

# Streamlit legacy dashboard port (optional)
STREAMLIT_PORT=8501

# ===== TELEGRAM DIGEST =====

# Create a bot with @BotFather, paste the token here, send the bot a message,
# then run: python send_telegram_digest.py --get-updates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Public channel or group the weekly digests go to
TELEGRAM_CHAT_ID=your_chat_id_here
# PRIVATE chat (your own DM with the bot) for run failure/success alerts.
# Message the bot, then: python send_telegram_digest.py --get-updates
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_ON_SUCCESS=1
TELEGRAM_MIN_SCORE=80
TELEGRAM_DIGEST_LIMIT=12
TELEGRAM_STORE_FILTER=
TELEGRAM_CATEGORY_FILTER=

# ===== PUBLIC WEB PAGE =====
# Base URL of the GitHub Pages site. The weekly "This Week's Deals" page is
# published at its root and every deal links to <base>/share/deals/<id>/.
PUBLIC_DASHBOARD_URL=https://mattdawe-collab.github.io/calgary-grocery-hub
# Optional footer links on the weekly page
FACEBOOK_GROUP_URL=
DASHBOARD_APP_URL=
